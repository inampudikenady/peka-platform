# PEKA local runtime configuration
PEKA_APP_NAME=PEKA
PEKA_APP_FULL_NAME="Private Enterprise Knowledge Assistant"
PEKA_DATASET_NAME="Demo Enterprise Knowledge Base"

# Qdrant/vector settings
PEKA_COLLECTION=unixdocs
PEKA_QDRANT_HOST=localhost
PEKA_QDRANT_PORT=6333

# Model settings
PEKA_MODEL=qwen2.5:3b
PEKA_EMBED_MODEL=BAAI/bge-base-en-v1.5
PEKA_LLM_TIMEOUT=1800

# Retrieval/reranking
PEKA_RETRIEVAL_TOP_K=8
PEKA_FINAL_TOP_K=2

# Ingestion
PEKA_WIKI_PATH=/opt/peka/data/wiki
PEKA_CHUNK_SIZE=800
PEKA_CHUNK_OVERLAP=100

# Docker/runtime data path
PEKA_DATA_DIR=/opt/peka/data

# Local WebUI
WEBUI_URL=http://localhost:3000
ENABLE_OAUTH_SIGNUP=false

# Disable Microsoft auth locally
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=
MICROSOFT_REDIRECT_URI=
OPENID_PROVIDER_URL=
MICROSOFT_OAUTH_SCOPE=

OAUTH_EMAIL_CLAIM=preferred_username
OAUTH_USERNAME_CLAIM=name
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
DEFAULT_USER_ROLE=user
ADMIN_EMAIL=kenady@vitwo.org

# ServiceNow dev
SERVICENOW_INSTANCE=https://dev274568.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD='q4k8xwRTN=@Z'

# Monitoring later
PROMETHEUS_URL=http://4.240.124.160:9090
LOKI_URL=http://4.240.124.160:3100
#PROMETHEUS_URL=http://localhost:9090
#LOKI_URL=http://localhost:3100
#################################################
# Demo Profile
#################################################

CUSTOMER_PROFILE=csi

TICKET_PROVIDER=servicenow
CMDB_PROVIDER=servicenow

MONITORING_PROVIDER=prometheus
LOG_PROVIDER=loki

