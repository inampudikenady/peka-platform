# PEKA local runtime configuration
PEKA_APP_NAME=PEKA
PEKA_APP_FULL_NAME="Private Enterprise Knowledge Assistant"
PEKA_DATASET_NAME="Demo Enterprise Knowledge Base"

COMPANY=Tuple
CUSTOMER_PROFILE=tuple
AUTH_PROVIDER=local

# Local repo data
PEKA_DATA_DIR=/opt/peka/data
PEKA_CMDB_FILE=./data/cmdb/tuple_cmdb.csv
PEKA_WIKI_PATH=/opt/peka/data/wiki

# Qdrant/vector settings
PEKA_COLLECTION=tuple_docs
PEKA_QDRANT_HOST=localhost
PEKA_QDRANT_PORT=6333

# Model settings
PEKA_MODEL=qwen2.5:3b
PEKA_EMBED_MODEL=BAAI/bge-base-en-v1.5
PEKA_LLM_TIMEOUT=1800

# Retrieval/reranking
PEKA_RETRIEVAL_TOP_K=8
PEKA_FINAL_TOP_K=2

# Ingestion
PEKA_CHUNK_SIZE=800
PEKA_CHUNK_OVERLAP=100

# Local WebUI
WEBUI_URL=http://localhost:3000
ENABLE_OAUTH_SIGNUP=false

# Source providers
CMDB_PROVIDER=auto
TICKET_PROVIDER=zammad
MONITORING_PROVIDER=docker_prometheus
LOG_PROVIDER=loki

# Existing local services
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
ZAMMAD_URL=http://localhost:8080
ZAMMAD_TOKEN=Vv1zdXlNA8lnyTBKFqHcym9qUyAnFvOIlsA3_SsB72j93Te_r-iMcCevUm1L_r7t

# Optional ServiceNow
SERVICENOW_INSTANCE=https://dev274568.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD='q4k8xwRTN=@Z'

# Future Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
